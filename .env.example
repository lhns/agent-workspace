# The run scripts copy this to .env and stop until you edit it. Every harness
# gets everything in .env. Uncomment and fill in what you use, or log in inside
# the container. Keys stay commented while unused: some agents (cline) crash on an
# empty ANTHROPIC_BASE_URL.

# ANTHROPIC_API_KEY=
# Only for a proxy/gateway; the default Anthropic API needs no value.
# ANTHROPIC_BASE_URL=
# OPENAI_API_KEY=

# Folder the agent works in. Empty = ./workspace. Else an absolute path,
# e.g. C:\code\myproject or /home/me/code/myproject.
# A shell variable overrides this per run: WORKSPACE_DIR=~/code/foo ./run-agent.sh claude
WORKSPACE_DIR=

# Build images on this machine instead of pulling prebuilt ones from ghcr.io (any value = yes).
AGENTS_LOCAL_BUILD=
# Where prebuilt images come from: <prefix>-<harness>:<hash>, e.g. for a fork or a mirror.
# AGENTS_IMAGE_PREFIX=ghcr.io/lhns/agent-workspace

# Proxy for image builds and the agents. Each also sets its lowercase variant.
# A proxy on this machine is host.docker.internal, not localhost. Docker's own
# image pulls use Docker's proxy settings, not these.
# HTTP_PROXY=
# HTTPS_PROXY=
# NO_PROXY=

# Mount consistency options for the workspace, passed to Docker as is (remote
# Docker setups with caching), e.g. read=cached,write=back,prefetch=eager,watch=coarse,owner=2000
# AGENTS_WORKSPACE_CONSISTENCY=

# Resume the last conversation for this folder on start: ask (default; a menu, resume
# preselected), yes, no, or pick (the harness's session picker). Any case.
# The launcher flags --continue/--new/--ask/--sessions override it.
# AGENTS_AUTORESUME=

# The harness to run when none is given on the command line (skips the harness menu).
# AGENTS_HARNESS=
# Any value = never show a menu (same as run-agent -y): last used harness, resume if there is a conversation.
# AGENTS_NONINTERACTIVE=
