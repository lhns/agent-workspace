# The run scripts copy this to .env and stop until you edit it. Every harness
# gets everything in .env. Uncomment and fill in what you use, or log in inside
# the container. Keys stay commented while unused: some agents (cline) crash on an
# empty ANTHROPIC_BASE_URL.

# ANTHROPIC_API_KEY=
# Only for a proxy/gateway; the default Anthropic API needs no value.
# ANTHROPIC_BASE_URL=
# OPENAI_API_KEY=

# Folder the agent works in. Empty = ./workspace. Else an absolute path,
# e.g. C:\code\myproject or /home/me/code/myproject.
# A shell variable overrides this per run: WORKSPACE_DIR=~/code/foo ./run-claude.sh
WORKSPACE_DIR=

# Build images on this machine instead of pulling prebuilt ones from ghcr.io (any value = yes).
LOCAL_BUILD=
# Where prebuilt images come from: <prefix>-<harness>:<hash>, e.g. for a fork or a mirror.
# IMAGE_PREFIX=ghcr.io/lhns/agent-workspace
