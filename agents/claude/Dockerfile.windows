# escape=`
FROM agent-workspace-base-windows
# renovate: datasource=npm depName=@anthropic-ai/claude-code
ARG CLAUDE_VERSION=2.1.319
# The cache goes outside ~/.cache (a volume target stays empty) and is dropped again.
RUN npm install -g --cache C:\npm-cache @anthropic-ai/claude-code@%CLAUDE_VERSION% && rmdir /s /q C:\npm-cache
ENV CLAUDE_CONFIG_DIR=$AGENTS_HOME\.claude
# The image pins the version (Renovate); an in-container update is lost on exit.
ENV DISABLE_AUTOUPDATER=1
